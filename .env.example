OPENWEATHER_API_KEY=your_api_key_here

MINIO_ENDPOINT=http://localhost:9000
# Docker services use MINIO_INTERNAL_ENDPOINT=http://minio:9000 from docker-compose.yml.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wade-lake
MINIO_REGION=us-east-1

WADE_STORAGE_BACKEND=minio
WADE_LAKE_PATH=./lake
WADE_DUCKDB_PATH=./data/wade.duckdb
WADE_MODEL_PATH=./models/isolation_forest.joblib
WADE_ANOMALY_PATH=./data/weather_anomalies.parquet
WADE_BACKFILL_START_DATE=2025-01-01
WADE_OPEN_METEO_SLEEP_SECONDS=1.0
WADE_OPEN_METEO_MAX_ATTEMPTS=5
WADE_OPEN_METEO_RETRY_DELAY_SECONDS=30
WADE_ANOMALY_CONTAMINATION=0.03
